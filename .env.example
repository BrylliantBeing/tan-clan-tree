# Copy to .env and fill in. Never prefix these with EXPO_PUBLIC_, which would expose them to the browser.

# Remote MySQL hostname from hPanel for local development, localhost on Hostinger
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Base URL used to build invite and password reset links
APP_URL=http://localhost:8081

# Mailbox used to send password reset emails. Confirm the host and port in hPanel.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
